# OpsPilot Configuration Environment Variables
PROJECT_NAME="OpsPilot"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Database Configuration (SQLite for local evaluation; PostgreSQL connection string for production)
DATABASE_URL="sqlite:///./opspilot.db"

# Security & Session Authentication
# In production, generate a secure random 32+ character key
SECRET_KEY="opspilot-production-grade-signing-key-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# LLM Provider Configuration
# Options: 'deterministic' (recommended for offline evaluation, zero API key required)
#          'gemini' (requires GEMINI_API_KEY)
#          'openai' (requires OPENAI_API_KEY)
LLM_PROVIDER="deterministic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEMO_MODE=true

# Security Guardrails & Limits
MAX_REQUEST_BODY_BYTES=1000000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
