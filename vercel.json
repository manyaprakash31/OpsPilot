{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "opspilot-backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "pip install -r requirements.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "opspilot-backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "opspilot-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
